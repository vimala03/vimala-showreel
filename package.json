{
  "name": "designup-reel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "iPad-first portfolio companion for DesignUp 2026. Independent of the main portfolio repo.",
  "scripts": {
    "assets": "sh scripts/copy-assets.sh",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 4173",
    "serve": "npm run build && npm run preview"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
